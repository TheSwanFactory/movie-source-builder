{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": { "type": "string", "enum": ["render", "storyboard"] },
    "formatVersion": { "type": "string", "pattern": "^1\\.\\d+\\.\\d+$" },
    "source": {
      "type": "object",
      "properties": {
        "hash": { "type": "string" },
        "projectId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "title": { "type": "string" }
      },
      "required": ["hash", "projectId", "title"],
      "additionalProperties": false
    },
    "configuration": {
      "type": "object",
      "properties": { "hash": { "type": "string" } },
      "required": ["hash"],
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "const": "movie-source-builder" },
        "version": { "type": "string" }
      },
      "required": ["name", "version"],
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "properties": {
        "width": { "type": "number" },
        "height": { "type": "number" },
        "frameRate": { "type": "number" }
      },
      "required": ["width", "height", "frameRate"],
      "additionalProperties": false
    },
    "status": { "type": "string", "enum": ["rendering", "complete", "failed"] },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "estimatedCost": { "type": "number", "minimum": 0 },
    "actualCost": { "type": "number", "minimum": 0 },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "cacheKey": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pending", "complete", "failed"]
          },
          "mediaPath": { "type": "string", "minLength": 1 },
          "mediaHash": { "type": "string" },
          "provider": { "type": "string" },
          "model": { "type": "string" },
          "requestId": { "type": "string" },
          "estimatedCost": { "type": "number", "minimum": 0 },
          "actualCost": { "type": "number", "minimum": 0 },
          "attempts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "warnings": { "type": "array", "items": { "type": "string" } },
          "error": { "type": "string" },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "panelPath": { "type": "string", "minLength": 1 },
          "panelHash": { "type": "string" },
          "timingAudioPath": { "type": "string", "minLength": 1 },
          "timingAudioHash": { "type": "string" },
          "timeline": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "enum": ["dialogue", "narration"] },
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "exclusiveMinimum": 0 },
                "character": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                },
                "text": { "type": "string", "minLength": 1 }
              },
              "required": ["type", "start", "end", "text"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "cacheKey",
          "status",
          "provider",
          "model",
          "estimatedCost",
          "actualCost",
          "attempts",
          "warnings"
        ],
        "additionalProperties": false
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "storyboard": {
      "type": "object",
      "properties": {
        "duration": { "type": "number", "minimum": 0 },
        "movie": { "type": "string", "minLength": 1 },
        "movieHash": { "type": "string" },
        "contactSheet": { "type": "string", "minLength": 1 },
        "contactSheetHash": { "type": "string" },
        "temporaryAudio": { "type": "boolean", "const": true },
        "timingAudioMode": {
          "type": "string",
          "enum": ["silence", "system-voice"]
        },
        "networkRequests": { "type": "number", "const": 0 },
        "assetHashes": {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "type": "string" }
        },
        "creativeInputHash": { "type": "string" },
        "approval": {
          "type": "object",
          "properties": {
            "approvedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
            },
            "creativeInputHash": { "type": "string" },
            "artifactHash": { "type": "string" }
          },
          "required": ["approvedAt", "creativeInputHash", "artifactHash"],
          "additionalProperties": false
        }
      },
      "required": [
        "duration",
        "movie",
        "movieHash",
        "contactSheet",
        "contactSheetHash",
        "temporaryAudio",
        "networkRequests",
        "assetHashes",
        "creativeInputHash"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "formatVersion",
    "source",
    "configuration",
    "tool",
    "settings",
    "status",
    "createdAt",
    "updatedAt",
    "estimatedCost",
    "actualCost",
    "shots",
    "warnings"
  ],
  "additionalProperties": false
}
