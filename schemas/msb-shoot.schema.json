{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": { "type": "string", "pattern": "^2\\.\\d+\\.\\d+$" },
    "shoot": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^\\d{4}-[a-z0-9][a-z0-9.-]*$" },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "status": { "type": "string", "enum": ["complete", "failed"] }
      },
      "required": ["id", "createdAt", "status"]
    },
    "shotlist": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^\\d{3}$" },
        "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "required": ["id", "hash"]
    },
    "engine": {
      "type": "object",
      "properties": {
        "configName": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "resolved": {
          "type": "object",
          "properties": {
            "version": { "type": "string", "pattern": "^1\\.\\d+\\.\\d+$" },
            "output": {
              "type": "object",
              "properties": {
                "aspectRatio": { "type": "string", "pattern": "^\\d+:\\d+$" },
                "width": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "height": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "frameRate": { "type": "number", "exclusiveMinimum": 0 }
              },
              "required": ["aspectRatio", "width", "height", "frameRate"]
            },
            "renderer": {
              "type": "object",
              "properties": {
                "provider": { "type": "string", "minLength": 1 },
                "model": { "type": "string", "minLength": 1 },
                "mode": {
                  "default": "image-to-video",
                  "type": "string",
                  "enum": ["image-to-video", "reference-to-video"],
                  "description": "The renderer capability this configuration selects, independent of creative content. Plan creation rejects a model whose registered capabilities do not match this mode."
                },
                "requiredEnvironmentVariables": {
                  "default": [],
                  "type": "array",
                  "items": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" }
                }
              },
              "required": ["provider", "model"]
            }
          },
          "required": ["version", "output", "renderer"],
          "additionalProperties": false
        }
      },
      "required": ["configName", "hash", "resolved"]
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "const": "movie-source-builder" },
        "version": { "type": "string" }
      },
      "required": ["name", "version"]
    },
    "costs": {
      "type": "object",
      "properties": {
        "estimated": { "type": "number", "minimum": 0 },
        "actual": { "type": "number", "minimum": 0 }
      },
      "required": ["estimated", "actual"]
    },
    "reused": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "shot": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "take": {
            "type": "string",
            "pattern": "^([a-z0-9][a-z0-9._-]*)\\.t(\\d{2,})$"
          },
          "from": { "type": "string", "minLength": 1 },
          "mediaHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "cacheKey": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "required": ["shot", "take", "from", "mediaHash", "cacheKey"]
      }
    },
    "takes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "shot": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "take": {
            "type": "string",
            "pattern": "^([a-z0-9][a-z0-9._-]*)\\.t(\\d{2,})$"
          },
          "status": { "type": "string", "enum": ["rendered", "failed"] },
          "cacheKey": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "media": { "type": "string", "minLength": 1 },
          "mediaHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "lastFrame": { "type": "string", "minLength": 1 },
          "chainScore": { "type": "number" },
          "requestId": { "type": "string" },
          "cost": { "default": 0, "type": "number", "minimum": 0 },
          "error": {
            "default": null,
            "anyOf": [{ "type": "string" }, { "type": "null" }]
          },
          "warnings": {
            "default": [],
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["shot", "take", "status", "cacheKey"]
      }
    },
    "findings": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "minLength": 1,
            "description": "Free-form scope; \"engine-compatibility\" and \"content-fidelity\" are the established ones."
          },
          "engine": { "type": "string" },
          "claim": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string" },
          "appliesTo": {
            "default": [],
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
          }
        },
        "required": ["scope", "claim"]
      }
    },
    "warnings": {
      "default": [],
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["formatVersion", "shoot", "shotlist", "engine", "tool", "costs"]
}
