{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": { "type": "string", "pattern": "^2\\.\\d+\\.\\d+$" },
    "dailies": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^\\d{4}$" },
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "by": { "type": "string", "minLength": 1 }
      },
      "required": ["id", "at", "by"]
    },
    "observations": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subject": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "take": {
                    "type": "string",
                    "pattern": "^([a-z0-9][a-z0-9._-]*)\\.t(\\d{2,})$"
                  }
                },
                "required": ["take"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "cut": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]*$"
                  },
                  "span": {
                    "type": "array",
                    "prefixItems": [
                      { "type": "number", "minimum": 0 },
                      { "type": "number", "minimum": 0 }
                    ],
                    "description": "Seconds on the screenplay timeline: [start, end]."
                  }
                },
                "required": ["cut"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "animatic": { "type": "boolean", "const": true },
                  "span": {
                    "type": "array",
                    "prefixItems": [
                      { "type": "number", "minimum": 0 },
                      { "type": "number", "minimum": 0 }
                    ],
                    "description": "Seconds on the screenplay timeline: [start, end]."
                  }
                },
                "required": ["animatic"],
                "additionalProperties": false
              }
            ]
          },
          "verdict": { "type": "string", "enum": ["circled", "rejected"] },
          "text": { "type": "string", "minLength": 1 },
          "notes": { "type": "string", "minLength": 1 },
          "attachments": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "description": "Evidence copied verbatim into dailies/<session>/."
          }
        }
      }
    }
  },
  "required": ["formatVersion", "dailies", "observations"]
}
