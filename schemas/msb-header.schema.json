{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": { "type": "string", "pattern": "^2\\.\\d+\\.\\d+$" },
    "project": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      },
      "required": ["id", "title"]
    },
    "cast": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "kind": {
            "default": "character",
            "type": "string",
            "enum": ["character", "location", "prop"]
          },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "modelSheet": {
            "type": "string",
            "minLength": 1,
            "description": "Isolated, neutral-backdrop identity reference under references/."
          },
          "needsModelSheet": {
            "default": false,
            "type": "boolean",
            "description": "Explicit flag that this cast member's model sheet is still owed; ingest fails a member with neither a model sheet nor this flag."
          }
        },
        "required": ["id", "name", "description"]
      }
    }
  },
  "required": ["formatVersion", "project"]
}
