{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": { "type": "string", "pattern": "^1\\.\\d+\\.\\d+$" },
    "output": {
      "type": "object",
      "properties": {
        "aspectRatio": { "type": "string", "pattern": "^\\d+:\\d+$" },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "frameRate": { "type": "number", "exclusiveMinimum": 0 }
      },
      "required": ["aspectRatio", "width", "height", "frameRate"],
      "additionalProperties": false
    },
    "renderer": {
      "type": "object",
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "requiredEnvironmentVariables": {
          "default": [],
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" }
        }
      },
      "required": ["provider", "model", "requiredEnvironmentVariables"],
      "additionalProperties": false
    }
  },
  "required": ["formatVersion", "output", "renderer"],
  "additionalProperties": false
}
