{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": { "type": "string", "pattern": "^1\\.\\d+\\.\\d+$" },
    "project": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      },
      "required": ["id", "title"],
      "additionalProperties": false
    },
    "screenplay": { "type": "string", "minLength": 1 },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "reference": {
            "type": "string",
            "minLength": 1,
            "description": "Packaged character source asset. It is not automatically sent to the renderer; use shots[].references for provider input."
          }
        },
        "required": ["id", "name", "description", "reference"],
        "additionalProperties": false
      }
    },
    "locations": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "description": { "type": "string", "minLength": 1 },
          "reference": {
            "type": "string",
            "minLength": 1,
            "description": "Packaged location source asset. It is not automatically sent to the renderer; use shots[].references for provider input."
          }
        },
        "required": ["id", "description"],
        "additionalProperties": false
      }
    },
    "props": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "description": { "type": "string", "minLength": 1 },
          "reference": {
            "type": "string",
            "minLength": 1,
            "description": "Packaged prop source asset. It is not automatically sent to the renderer; use shots[].references for provider input."
          }
        },
        "required": ["id", "description"],
        "additionalProperties": false
      }
    },
    "shots": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "duration": {
            "anyOf": [
              { "type": "number", "const": 6 },
              { "type": "number", "const": 8 },
              { "type": "number", "const": 10 }
            ]
          },
          "characters": {
            "default": [],
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
          },
          "location": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "dialogue": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "character": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                },
                "text": { "type": "string", "minLength": 1 },
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "exclusiveMinimum": 0 }
              },
              "required": ["text", "start", "end"],
              "additionalProperties": false
            }
          },
          "narration": { "type": "string" },
          "action": { "type": "string", "minLength": 1 },
          "camera": { "type": "string", "minLength": 1 },
          "references": {
            "default": { "identity": [] },
            "type": "object",
            "properties": {
              "identity": {
                "default": [],
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "description": "Explicit raster identity references (e.g. one per recurring character) for reference-to-video renderers. Not automatically populated from characters[]/props[] — a path must be listed here to be uploaded."
              },
              "composition": {
                "type": "string",
                "minLength": 1,
                "description": "Explicit starting-frame / opening-composition raster for single-image renderers. The current image-to-video fal adapters upload only this image as their input."
              },
              "endFrame": {
                "type": "string",
                "minLength": 1,
                "description": "Explicit ending-frame raster for renderers that support first/last-frame generation."
              }
            },
            "required": ["identity"],
            "additionalProperties": false
          },
          "continuity": {
            "default": [],
            "type": "array",
            "items": { "type": "string" },
            "description": "Text prompt guidance only; this does not lock identity or pass frames between independently generated shots."
          }
        },
        "required": [
          "id",
          "duration",
          "characters",
          "dialogue",
          "action",
          "camera",
          "references",
          "continuity"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "formatVersion",
    "project",
    "characters",
    "locations",
    "props",
    "shots"
  ],
  "additionalProperties": false
}
